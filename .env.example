# Stockage local de démonstration : aucune donnée réelle de Framatex
FRAMATEX_DATA_DIR=./data
# Production : renseigner une clé secrète aléatoire de 32 caractères minimum
# FRAMATEX_SECRET_KEY=...
# Base : SQLite par défaut (data/framat.db). PostgreSQL : voir la section en fin de fichier.
# FRAMATEX_COOKIE_SECURE=1  # OBLIGATOIRE derrière HTTPS
# Origine approuvée pour les étiquettes QR. Par défaut : http://127.0.0.1:8000
# FRAMATEX_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Pour un pilote : nouveaux lancements restreints dès la création (0/1)
FRAMATEX_RESTRICT_NEW_LAUNCHES=0

# Limites par fichier pour les dépôts internes, de 1 à 200 Mio.
# FRAMATEX_UPLOAD_PDF_MIB=200
# FRAMATEX_UPLOAD_EXCEL_MIB=100
# FRAMATEX_UPLOAD_WORD_MIB=100
# FRAMATEX_UPLOAD_IMAGE_MIB=50
# FRAMATEX_UPLOAD_OTHER_MIB=20

# Lecture documentaire locale : plafonds de sécurité (à ajuster selon la machine).
# FRAMATEX_ANALYSIS_MAX_BYTES=12582912
# FRAMATEX_ANALYSIS_MAX_PAGES=80
# FRAMATEX_ANALYSIS_MAX_TEXT=180000
# FRAMATEX_ANALYSIS_TIMEOUT_SECONDS=90
# FRAMATEX_ANALYSIS_MAX_MEMORY_MIB=768
# FRAMATEX_OCR_PAGE_TIMEOUT_SECONDS=12
# FRAMATEX_OCR_MAX_IMAGE_PIXELS=12000000
# FRAMATEX_OCR_DPI=240
# Sous Windows, laisser vide si Tesseract est dans PATH ; sinon par exemple :
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# ---------------------------------------------------------------------------------------------
# PostgreSQL (scripts/start_postgresql_windows.cmd lit ces valeurs ; DATABASE_URL est construite
# sans mot de passe, celui-ci étant transmis par PGPASSWORD au seul processus FRAMATEX).
FRAMATEX_PG_HOST=127.0.0.1
FRAMATEX_PG_PORT=5432
FRAMATEX_PG_DATABASE=framatex
FRAMATEX_PG_USER=framatex
# Mot de passe long et aléatoire (au moins 20 caractères), propre à ce poste. Ne jamais le versionner.
FRAMATEX_PG_PASSWORD=
# docker : PostgreSQL dans Docker Desktop (docker-compose.postgresql.yml)
# local  : PostgreSQL 16 installé directement sous Windows (service « postgresql-x64-16 »)
FRAMATEX_PG_MODE=docker
